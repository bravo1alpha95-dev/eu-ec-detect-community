# Copy to .env and chmod 600. No real secrets in git.
# Parsed as plain KEY=value (not sourced): no quotes, spaces, $ or `; values limited to A-Za-z0-9._/:@+,-
# EU_SCOPE_CIDR may list several ranges separated by commas. EU_FAIL_CLOSED=1 makes
# preflight stop (exit 4) when no host address is inside EU_SCOPE_CIDR.
#
# The addresses below are placeholders in the documentation range 192.0.2.0/24 (RFC 5737).
# Replace them with the authorized range for systems you own. Do not point this
# toolkit at third-party or otherwise unauthorized networks.
EU_ORG=example
EU_ENV=lab
EU_PROJECT=eu-ec-detect
EU_SCOPE_CIDR=192.0.2.0/24
EU_OPS_HOST=ops-01
EU_OPS_IP=192.0.2.10
