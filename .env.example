# Copy to .env and chmod 600. No real secrets in git.
# Parsed as plain KEY=value (not sourced): no quotes, spaces, $ or `; values limited to A-Za-z0-9._/:@+-
#
# The addresses below are placeholders in the documentation range 10.0.0.0/24.
# Replace them with the authorized range for systems you own. Do not point this
# toolkit at third-party or otherwise unauthorized networks.
EU_ORG=example
EU_ENV=lab
EU_PROJECT=eu-ec-detect
EU_SCOPE_CIDR=10.0.0.0/24
EU_OPS_HOST=ops-01
EU_OPS_IP=10.0.0.10
